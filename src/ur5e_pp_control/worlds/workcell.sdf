<?xml version="1.0"?>
<!-- Pick-and-place workcell: ground, table, pick zone (red) and place zone (green).
     The box itself is spawned by sim.launch.py so its mass can be set. -->
<sdf version="1.9">
  <world name="workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Table: top at z = 0.08 m. With the tool at z = 0.25 and a 10 cm gripper,
         the gripper tip (z = 0.15) touches the top of a 7 cm box on the table. -->
    <model name="table">
      <static>true</static>
      <pose>0.45 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.75 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.75 0.08</size></box></geometry>
          <material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.55 0.38 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Zone markers (visual only) at pick (0.45, -0.20) and place (0.45, +0.20) -->
    <model name="pick_zone">
      <static>true</static>
      <pose>0.45 -0.20 0.0805 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="place_zone">
      <static>true</static>
      <pose>0.45 0.20 0.0805 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
